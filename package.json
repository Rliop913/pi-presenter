{
  "name": "@rliop/pi-presenter",
  "version": "0.1.0",
  "description": "Approval-gated, evidence-grounded presentation production for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "presentation",
    "pptx"
  ],
  "files": [
    "src/index.ts",
    "src/file-tools.ts",
    "src/authority-schema.ts",
    "src/storage.ts",
    "src/models.ts",
    "src/wizard.ts",
    "src/process.ts",
    "src/dependencies.ts",
    "src/reference-sites.ts",
    "src/design-references.ts",
    "skills",
    "README.md",
    "docs/design-references-and-dependencies.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/presenter"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/skill-*.test.ts tests/dependencies.test.ts tests/reference-bounds.test.ts tests/assignments.test.ts tests/presets.test.ts",
    "test:skill": "tsx --test tests/skill-*.test.ts"
  },
  "dependencies": {
    "parse5": "8.0.0",
    "pptxgenjs": "4.0.0",
    "jszip": "^3.10.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
